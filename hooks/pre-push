#!/bin/sh
# Blocks a push if the gates fail. Install with:  ./hooks/install.sh
ROOT="$(git rev-parse --show-toplevel)"
P="$ROOT/plugins/records-project"

echo "privacy gate..."
python3 "$P/scripts/lint_privacy.py" || {
  echo
  echo "PUSH BLOCKED - the privacy gate did not pass."
  echo "Fix the findings above, or run with --no-verify if you are certain."
  exit 1
}
python3 "$P/scripts/lint_frontmatter.py" >/dev/null || {
  echo "PUSH BLOCKED - a SKILL.md uses non-portable frontmatter."
  exit 1
}
echo "regression suite..."
python3 "$P/tests/test_regressions.py" 2>&1 | tail -3 || {
  echo
  echo "PUSH BLOCKED - a regression test failed."
  echo "Every test in that suite corresponds to a bug that actually shipped;"
  echo "a failure means one of them is back. Read the test's docstring."
  exit 1
}
echo "gates passed."
